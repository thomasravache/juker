<Project>
  <!--
    Propriedades comuns aos projetos em tests/ (SPEC-0003). Importa o Directory.Build.props da raiz, que o MSBuild
    deixaria de importar por encontrar este arquivo primeiro.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      Projetos ainda vazios declaram JukerAllowZeroTests=true no próprio .csproj. A propriedade não muda o dotnet test
      (toda execução aceita zero testes, tests/Directory.Build.targets): só diz ao teste de convenção SPEC-0027:UT-03
      que o projeto está vazio de propósito, e sai do .csproj junto com os primeiros testes.
    -->
    <JukerAllowZeroTests Condition="'$(JukerAllowZeroTests)' == ''">false</JukerAllowZeroTests>
  </PropertyGroup>
</Project>
