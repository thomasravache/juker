<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Testes de componentes Blazor com bUnit (ADR-0011, ADR-0013).
    Sem testes nesta spec: cada spec traz os seus (SPEC-0003, ADR-0011). Enquanto estiver vazio, o projeto aceita
    zero testes (JukerAllowZeroTests, ver tests/Directory.Build.targets). A spec que acrescentar os primeiros testes
    remove a propriedade, para que um projeto que perca seus testes volte a falhar.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <JukerAllowZeroTests>true</JukerAllowZeroTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Web\Juker.Web\Juker.Web.csproj" />
  </ItemGroup>

</Project>
