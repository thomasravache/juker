<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Testes de componentes Blazor com bUnit (ADR-0011, ADR-0013).
    Sem testes nesta spec: cada spec traz os seus (SPEC-0003, ADR-0011). Um projeto sem testes não falha o
    `dotnet test` (código de saída 8 ignorado em tests/Directory.Build.props).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Web\Juker.Web\Juker.Web.csproj" />
  </ItemGroup>

</Project>
