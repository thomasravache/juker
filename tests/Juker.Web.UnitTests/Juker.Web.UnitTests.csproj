<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Testes de componentes Blazor com bUnit (ADR-0011, ADR-0013).
    Sem testes nesta spec: cada spec traz os seus (SPEC-0003, ADR-0011). Toda execução aceita zero testes
    (tests/Directory.Build.targets, SPEC-0027); JukerAllowZeroTests só diz ao teste de convenção SPEC-0027:UT-03 que
    o projeto está vazio de propósito. A spec que acrescentar os primeiros testes remove a propriedade (o arch_test
    falha enquanto ela continuar num projeto com testes), para que um projeto que perca seus testes volte a falhar.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <JukerAllowZeroTests>true</JukerAllowZeroTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Web\Juker.Web\Juker.Web.csproj" />
  </ItemGroup>

</Project>
