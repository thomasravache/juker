<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes de unidade do módulo Venues (handlers, domínio e validação, sem infraestrutura).
    Sem testes nesta spec: cada spec traz os seus (SPEC-0003, ADR-0011). Enquanto estiver vazio, o projeto aceita
    zero testes (JukerAllowZeroTests, ver tests/Directory.Build.props). A spec que acrescentar os primeiros testes
    remove a propriedade, para que um projeto que perca seus testes volte a falhar.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <JukerAllowZeroTests>true</JukerAllowZeroTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Venues\Juker.Modules.Venues\Juker.Modules.Venues.csproj" />
  </ItemGroup>

</Project>
