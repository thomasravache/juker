<?xml version="1.0" encoding="utf-8"?>
<!--
  Fontes de pacote do Juker (SPEC-0002): somente nuget.org, com package source mapping.
  O <clear/> descarta os feeds globais da máquina, para o restore ser igual no dev e no CI
  e o NU1507 (várias fontes com gerenciamento central) não aparecer.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
